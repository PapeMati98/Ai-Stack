{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-stack.invalid/schemas/jit-shadow-telemetry/0.1",
  "title": "Sanitized JIT shadow telemetry receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "receipt_id", "static_contract_sha256",
    "candidate_sha256", "decision", "reason_codes", "static_path_selected"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"enum": ["stage-a", "stage-b"]},
    "receipt_id": {"type": "string", "pattern": "^jit-receipt-[a-f0-9]{24}$"},
    "static_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["accepted-shadow", "rejected", "unavailable", "late", "disabled"]},
    "reason_codes": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}
    },
    "static_path_selected": {"const": true}
  }
}
