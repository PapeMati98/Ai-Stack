{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-stack.invalid/schemas/agent-graph/0.1/amendment.schema.json",
  "title": "Agent Graph 0.2 legacy recovery amendment (schema v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "amendment_id",
    "base_revision",
    "reason",
    "triggered_by_node",
    "invalidate_nodes",
    "add_nodes",
    "new_integration_node_id",
    "approval_scope"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "amendment_id": {
      "type": "string",
      "pattern": "^amend-[a-z0-9][a-z0-9-]{2,95}$"
    },
    "base_revision": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 12, "maxLength": 4000},
    "triggered_by_node": {
      "type": "string",
      "pattern": "^node-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "invalidate_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^node-[a-z0-9][a-z0-9-]{2,63}$"
      }
    },
    "add_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "graph.schema.json#/$defs/node"}
    },
    "new_integration_node_id": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "pattern": "^node-[a-z0-9][a-z0-9-]{2,63}$"
        }
      ]
    },
    "approval_scope": {
      "enum": ["technical-parent", "human-business", "human-sensitive"]
    }
  }
}
