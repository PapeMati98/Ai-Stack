{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-stack.invalid/schemas/agent-graph/0.1/evidence.schema.json",
  "title": "Agent Graph 0.2 node evidence (schema v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "node_id",
    "verdict",
    "summary",
    "workspace_root",
    "changed_paths",
    "artifacts",
    "criteria_results",
    "checks",
    "external_refs",
    "findings",
    "telemetry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-[a-z0-9][a-z0-9-]{2,95}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^node-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "verdict": {"enum": ["accepted", "rejected", "blocked"]},
    "summary": {"type": "string", "minLength": 4, "maxLength": 4000},
    "workspace_root": {"type": "string", "minLength": 1, "maxLength": 1024},
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/relativeFile"}
    },
    "artifacts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"$ref": "#/$defs/relativeFile"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "criteria_results": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence_ref"],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^crit-[a-z0-9][a-z0-9-]{2,63}$"
          },
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence_ref"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "external_refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": {
            "enum": [
              "fleet_run",
              "agent_loop",
              "fleet_quality_gate",
              "fleet_security_gate",
              "human_approval",
              "parent_acceptance"
            ]
          },
          "id": {"type": "string", "minLength": 3, "maxLength": 256}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "summary", "evidence_ref"],
        "properties": {
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "code": {"type": "string", "minLength": 2, "maxLength": 100},
          "summary": {"type": "string", "minLength": 4, "maxLength": 1000},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "tool_calls",
        "cost_usd",
        "quota_before",
        "quota_after",
        "duration_seconds"
      ],
      "properties": {
        "model": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "quota_before": {"type": ["number", "string", "null"]},
        "quota_after": {"type": ["number", "string", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    }
  },
  "$defs": {
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[\\\\*?\"<>|])[^/]+(?:/[^/]+)*$"
    }
  }
}
