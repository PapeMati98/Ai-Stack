{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-stack.invalid/schemas/jit-node-static-contract/0.1",
  "title": "Frozen Stage B static node authority contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "planning_contract_sha256", "graph_sha256",
    "node_id", "static_template_id", "pilot_mode", "control_veto", "objective",
    "capability", "required_context_refs", "allowed_context_refs", "skill_allowlist",
    "tool_allowlist", "read_scope", "write_scope", "budget", "stop_conditions",
    "criterion_refs", "repair_policy", "reviewer_capabilities",
    "maker_provider_lineage", "reviewer_provider_lineage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "minLength": 3, "maxLength": 120},
    "planning_contract_sha256": {"$ref": "#/$defs/sha256"},
    "graph_sha256": {"$ref": "#/$defs/sha256"},
    "node_id": {"type": "string", "pattern": "^node-[a-z0-9][a-z0-9-]{2,100}$"},
    "static_template_id": {"type": "string", "minLength": 3, "maxLength": 100},
    "pilot_mode": {"const": "shadow-only"},
    "control_veto": {"type": "boolean"},
    "objective": {"type": "string", "minLength": 8, "maxLength": 2000},
    "capability": {"type": "string", "minLength": 3, "maxLength": 100},
    "required_context_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/context"}},
    "allowed_context_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/context"}},
    "skill_allowlist": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}},
    "tool_allowlist": {"$ref": "#/$defs/stringList"},
    "read_scope": {"$ref": "#/$defs/stringList"},
    "write_scope": {"$ref": "#/$defs/stringList"},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_wall_seconds", "max_tool_calls", "max_tokens", "max_attempts"],
      "properties": {
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "stop_conditions": {"$ref": "#/$defs/stringList"},
    "criterion_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^crit-[a-z0-9][a-z0-9-]{2,100}$"}},
    "repair_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["on_reject", "max_repairs"],
      "properties": {
        "on_reject": {"enum": ["static-fallback", "bounded-repair", "block"]},
        "max_repairs": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "reviewer_capabilities": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 100}},
    "maker_provider_lineage": {"type": "string", "minLength": 2, "maxLength": 100},
    "reviewer_provider_lineage": {"type": "string", "minLength": 2, "maxLength": 100}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/sha256"},
        "purpose": {"type": "string", "minLength": 3, "maxLength": 300}
      }
    },
    "stringList": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
