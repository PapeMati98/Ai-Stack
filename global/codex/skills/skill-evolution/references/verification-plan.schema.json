{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-stack:skill-evolution:verification-plan:1",
  "title": "Skill Evolution paired verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "candidate_id",
    "targeted_test_ids",
    "preservation_test_ids",
    "confirmation_test_ids",
    "confirmation_overlap_count",
    "status",
    "reason_codes",
    "catalog_sha256",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^verification-[a-f0-9]{16}$"},
    "candidate_id": {"type": "string", "pattern": "^candidate-[a-z0-9][a-z0-9-]{2,95}$"},
    "targeted_test_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^test-[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "preservation_test_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^test-[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "confirmation_test_ids": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^test-[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "confirmation_overlap_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "status": {"enum": ["READY", "NEEDS_EVIDENCE"]},
    "reason_codes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
    },
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
