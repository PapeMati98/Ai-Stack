{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-stack:skill-evolution:pattern:1",
  "title": "Skill Evolution compiled pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern_id",
    "signature",
    "evidence_ids",
    "independent_run_count",
    "independent_actor_count",
    "supported_model_families",
    "supported_runtimes",
    "applicability",
    "status",
    "pattern_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pattern_id": {"type": "string", "pattern": "^pattern-[a-f0-9]{16}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_family", "role", "model_family", "runtime", "tool_surface",
        "environment", "symptom", "expected_behavior", "outcome"
      ],
      "properties": {
        "task_family": {"type": "string"},
        "role": {"type": "string"},
        "model_family": {"type": "string"},
        "runtime": {"type": "string"},
        "tool_surface": {"type": "string"},
        "environment": {"type": "string"},
        "symptom": {"type": "string"},
        "expected_behavior": {"type": "string"},
        "outcome": {"enum": ["success", "failure", "recovered"]}
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{2,95}$"}
    },
    "independent_run_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "independent_actor_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "supported_model_families": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}
    },
    "supported_runtimes": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}
    },
    "applicability": {"enum": ["universal", "model-family", "runtime-specific", "task-specific"]},
    "status": {"enum": ["ELIGIBLE", "NEEDS_EVIDENCE"]},
    "pattern_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
