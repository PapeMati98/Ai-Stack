{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-stack.invalid/schemas/plan-delivery/0.2/owner-ceiling.schema.json",
  "title": "Owner token ceiling with isolated planning and execution pools",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planning_and_review",
    "execution",
    "unknown_usage_policy",
    "quota_snapshot_max_age_hours",
    "routing",
    "capability_floor"
  ],
  "properties": {
    "token_policy": {
      "enum": ["hard", "estimate"],
      "default": "estimate",
      "description": "Default is estimate for planning forecasts. An explicit hard value remains an owner ceiling and must never be weakened."
    },
    "planning_and_review": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000,
      "description": "Tokens for fidelity/sufficiency gates, reviews, council, and contract audits. Owner-declared; not a code default."
    },
    "execution": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000,
      "description": "Tokens for approved graph node runs. Must equal graph.global_budget.max_total_tokens."
    },
    "unknown_usage_policy": {
      "enum": ["preserve_unknown", "pessimistic_max_tokens"],
      "description": "Unknown telemetry remains unknown; the legacy pessimistic_max_tokens label is accepted for compatibility but no substitute token charge is fabricated."
    },
    "quota_snapshot_max_age_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_and_review", "execution"],
      "properties": {
        "planning_and_review": {"const": "quality"},
        "execution": {"const": "cost_above_capability_floor"}
      }
    },
    "capability_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "minimum_scores",
        "minimum_first_pass",
        "minimum_evidence_confidence"
      ],
      "properties": {
        "source": {"const": "profiles.capabilities"},
        "minimum_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instruction-following", "tool-use", "write"],
          "properties": {
            "instruction-following": {"type": "integer", "minimum": 0, "maximum": 100},
            "tool-use": {"type": "integer", "minimum": 0, "maximum": 100},
            "write": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "minimum_first_pass": {"type": "integer", "minimum": 0, "maximum": 100},
        "minimum_evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
