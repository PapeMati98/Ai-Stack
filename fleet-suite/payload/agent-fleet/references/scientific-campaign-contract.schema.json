{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Fleet scientific campaign contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "mode",
    "objective",
    "owner",
    "gate_0",
    "experiment_cards",
    "hardware_budget",
    "stop_rules",
    "review_policy",
    "promotion_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "pattern": "^campaign-[A-Za-z0-9][A-Za-z0-9-]{7,127}$"},
    "mode": {"const": "scientific-campaign"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "gate_0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "owner", "status", "evidence_ref"],
      "properties": {
        "required": {"const": true},
        "owner": {"const": "parent"},
        "status": {"enum": ["pending", "passed", "blocked"]},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "experiment_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "pattern": "^experiment-[A-Za-z0-9][A-Za-z0-9-]{7,127}$"},
      "uniqueItems": true
    },
    "hardware_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrent_runs", "max_total_runs", "max_gpu_hours"],
      "properties": {
        "max_concurrent_runs": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_total_runs": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_gpu_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000}
      }
    },
    "stop_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_improvement", "no_convergence", "budget_exceeded", "data_quality_failure"],
      "properties": {
        "no_improvement": {"const": true},
        "no_convergence": {"const": true},
        "budget_exceeded": {"const": true},
        "data_quality_failure": {"const": true}
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_scope", "repair_scope", "parent_after_gate"],
      "properties": {
        "reviewer_scope": {"const": "group"},
        "repair_scope": {"const": "rejected-only"},
        "parent_after_gate": {"const": true}
      }
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "deploy", "promotion"],
      "properties": {
        "merge": {"const": false},
        "deploy": {"const": false},
        "promotion": {"const": false}
      }
    }
  }
}
