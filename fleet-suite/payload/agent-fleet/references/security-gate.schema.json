{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Fleet incremental security gate result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "items", "integration", "unresolved_risks"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["ACCEPT", "REPAIR", "BLOCKED"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_task_id",
          "run_id",
          "verdict",
          "quality_score",
          "criteria_passed",
          "criteria_failed",
          "findings"
        ],
        "properties": {
          "root_task_id": {
            "type": "string",
            "pattern": "^task-[A-Za-z0-9][A-Za-z0-9-]{7,127}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{10}$"
          },
          "verdict": {
            "type": "string",
            "enum": ["ACCEPT", "REPAIR", "BLOCKED"]
          },
          "quality_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "criteria_passed": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "criteria_failed": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "findings": {
            "type": "array",
            "maxItems": 100,
            "items": {"$ref": "#/$defs/finding"}
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "verification",
        "criteria_passed",
        "criteria_failed",
        "findings"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["ACCEPT", "REPAIR", "BLOCKED"]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "criteria_passed": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "criteria_failed": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/finding"}
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "cwe",
        "location",
        "exploit_path",
        "confidence",
        "evidence",
        "remediation"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"]
        },
        "cwe": {
          "type": "string",
          "pattern": "^(CWE-[1-9][0-9]{0,4}|N/A)$"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "exploit_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
