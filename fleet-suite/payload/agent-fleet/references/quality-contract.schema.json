{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Fleet quality group contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "group_id",
    "title",
    "acceptance_criteria",
    "integration_criteria",
    "risk",
    "max_repair_rounds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "group_id": {
      "type": "string",
      "pattern": "^group-[A-Za-z0-9][A-Za-z0-9-]{7,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "integration_criteria": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "max_repair_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "reviewer_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "approval_ref",
        "agent",
        "model",
        "provider",
        "execution_profile",
        "scope_group_id",
        "mode",
        "reason",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "owner-authorized-narrow-security-review-v1"
        },
        "approval_ref": {
          "type": "string",
          "pattern": "^owner-intake:[A-Za-z0-9._:-]+$"
        },
        "agent": {
          "const": "muse"
        },
        "model": {
          "const": "muse-spark-1.3"
        },
        "provider": {
          "const": "meta"
        },
        "execution_profile": {
          "const": "muse-spark-1-3-read-high"
        },
        "scope_group_id": {
          "type": "string",
          "pattern": "^group-[A-Za-z0-9][A-Za-z0-9-]{7,127}$"
        },
        "mode": {
          "const": "review"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
