{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "kind",
    "release_state",
    "platforms",
    "runtime_target",
    "components",
    "adapter_ids",
    "declared_effects",
    "prohibited_effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "const": "agent-fleet-suite"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "executable-agent-suite"
    },
    "release_state": {
      "enum": [
        "candidate",
        "released"
      ]
    },
    "platforms": {
      "const": [
        "windows"
      ]
    },
    "runtime_target": {
      "const": "~/.agents/runtime/agent-fleet-suite/current"
    },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "adapter_ids": {
      "const": [
        "agent-fleet",
        "model-radar",
        "agent-cli",
        "agent-loop"
      ]
    },
    "declared_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
